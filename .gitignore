# ==============================================================================
# ENVIRONMENT VARIABLES & SENSITIVE CREDENTIALS (CRITICAL SECURITY)
# Prevents leaking passwords, API keys, Google App Passwords, secrets & auth tokens
# ==============================================================================
.env
.env.*
*.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.backup
.env.bak
.env.old
.env.save

# Allow safe example and template environment files to be committed
!.env.example
!.env.sample
!.env.template

# Secret credentials, tokens & service accounts
*credentials*.json
client_secret*.json
service-account*.json
serviceAccountKey*.json
google-credentials*.json
firebase-adminsdk*.json
token.json
tokens.json
auth*.json
secret*.json
secret*.yml
secret*.yaml

# Private Keys, Certificates, SSH & Keystores
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.keystore
*.jks
*.der
*.cer
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
id_ecdsa
id_dsa

# Secret & Credential directories
secrets/
.secrets/
credentials/
.credentials/
certs/
certificates/
private/

# Package manager & CLI authentication credentials
.npmrc
.yarnrc
.netrc
.aws/
.azure/
.gcloud/

# Databases & local data dumps (prevent leaking customer / submission data)
*.sqlite
*.sqlite3
*.db
*.sql
*.dump

# ==============================================================================
# DEPENDENCIES
# ==============================================================================
node_modules/
.pnp/
.pnp.js

# ==============================================================================
# BUILD & PRODUCTION OUTPUTS
# ==============================================================================
dist/
dist-ssr/
build/
coverage/
*.tsbuildinfo

# ==============================================================================
# LOGS & DEBUG RUNTIME
# ==============================================================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==============================================================================
# OS & SYSTEM FILES
# ==============================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# ==============================================================================
# IDE & EDITOR DIRECTORIES
# ==============================================================================
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
*.bak
*.backup
*.tmp
